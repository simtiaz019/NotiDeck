# Copy to a private environment file; do not commit actual secrets.
# NOTIDECK_CONFIG_DIR=/var/lib/notideck
# NOTIDECK_DATA_DIR=/var/lib/notideck
# NOTIDECK_MASTER_KEY=<Fernet key generated and backed up securely>
# NOTIDECK_DATABASE_URL=postgresql+psycopg://user:URL_ENCODED_PASSWORD@host/notideck
# NOTIDECK_SECURE_COOKIES=1
# NOTIDECK_PASSWORD_MIN_LENGTH=12
# Explicit, deployment-owned exceptions for internal webhooks/Signal:
# NOTIDECK_OUTBOUND_ALLOW_NETWORKS=10.20.0.0/16
# POSTGRES_PASSWORD=<unique password for PostgreSQL Compose>
# NOTIDECK_TEST_DATABASE_URL=<dedicated disposable integration database>
